{
  "dashboard": {
    "title": "FastAPI Metrics",
    "tags": ["fastapi"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Request Rate",
        "targets": [
          {
            "expr": "rate(fastapi_requests_total[1m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Request Duration",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(fastapi_request_duration_seconds_bucket[5m]))"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Active Requests",
        "targets": [
          {
            "expr": "fastapi_active_requests"
          }
        ],
        "type": "stat"
      }
    ]
  }
}