{
  "dashboard": {
    "title": "FastAPI Metrics - EVA02",
    "tags": ["fastapi", "eva02"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/sec)",
        "targets": [
          {
            "expr": "rate(fastapi_requests_total[1m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Response Time p95 (ms)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(fastapi_request_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Active Requests",
        "targets": [
          {
            "expr": "fastapi_active_requests",
            "legendFormat": "active"
          }
        ],
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Total Requests by Status",
        "targets": [
          {
            "expr": "fastapi_requests_total",
            "legendFormat": "{{status_code}}"
          }
        ],
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "Response Time Distribution",
        "targets": [
          {
            "expr": "rate(fastapi_request_duration_seconds_bucket[5m])",
            "legendFormat": "{{le}}"
          }
        ],
        "type": "heatmap",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        }
      }
    ]
  },
  "overwrite": true
}
