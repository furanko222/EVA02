# ===== DATABASE CONFIGURATION =====
SQLALCHEMY_DATABASE_URI=postgresql://postgres:pass@db:5432/test_db
# Format: postgresql://user:password@host:port/database

# ===== SECURITY =====
SECRET_KEY=your-secret-key-change-in-production
# Mínimo 32 caracteres aleatorios en producción
# Generar con: openssl rand -hex 32

ACCESS_TOKEN_EXPIRE_MINUTES=30
# Tiempo de expiración del token JWT en minutos

# ===== JWT CONFIGURATION =====
ALGORITHM=HS256
# Algoritmo para cifrado JWT (HS256, HS384, HS512)

# ===== APPLICATION =====
DEBUG=false
# Activar modo debug (nunca en producción)

# ===== SUPERUSER (INICIAL) =====
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme
# Credenciales del primer usuario superusuario

# ===== CORS (PRODUCCIÓN) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# URLs permitidas para CORS (separadas por comas)

# ===== LOGGING =====
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===== API =====
API_V1_STR=/api/v1
# Prefijo para endpoints de API v1

PROJECT_NAME=EVA02
# Nombre del proyecto

# ===== DOCKER COMPOSE (PRODUCCIÓN) =====
DB_PASSWORD=your_secure_password
DB_NAME=eva02_db
APP_PORT=8000

# ===== OPTIONAL: EXTERNAL SERVICES =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
